# Copy to .env and fill in. Never commit .env.

# API
CARTSENSE_DATABASE_URL=sqlite:///./cartsense.db
CARTSENSE_JWT_SECRET=replace-with-a-long-random-string
CARTSENSE_CORS_ORIGINS=http://localhost:3000
CARTSENSE_EXPORT_DIR=../../artifacts/export
# Product images are hosted by Amazon; keep false for public deployments
CARTSENSE_SHOW_PRODUCT_IMAGES=false

# docker compose
POSTGRES_PASSWORD=change-me

# Web (apps/web/.env), read at build time
VITE_API_URL=http://localhost:8000
